# =============================================================================
# AuthoryxOS — Environment Variables
# Copy to .env and fill in values. Never commit .env to source control.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL=postgresql://authoryx:authoryx@localhost:5432/authoryx_os

# Redis for queues, sessions, ephemeral token cache
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=change_me_generate_with_openssl_rand_hex_64

# Session secret
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32

# Token expiry
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Vault / Crypto ────────────────────────────────────────────────────────────
# Master key for server-side envelope encryption (AES-256-GCM)
# For zero-knowledge mode, leave this empty and rely on client-side keys only
# Generate with: openssl rand -hex 32
VAULT_MASTER_KEY=change_me_generate_with_openssl_rand_hex_32

# KDF iterations (higher = slower brute force, worse UX — 600000 is NIST minimum)
PBKDF2_ITERATIONS=600000

# ── SMS / Relay ───────────────────────────────────────────────────────────────
# Shared relay secret — mobile apps sign their relay payloads with this
SMS_RELAY_SECRET=change_me_generate_with_openssl_rand_hex_32

# Optional: Twilio fallback for sending OTPs out-of-band
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AuthoryxOS Agent Runtime ──────────────────────────────────────────────────
# Max duration (seconds) a secret is held in memory for an agent call
AGENT_SECRET_TTL_SECONDS=30

# Require explicit human approval for agent secret access (true = safer default)
AGENT_REQUIRE_APPROVAL=true

# Audit log retention in days (0 = keep forever)
AUDIT_LOG_RETENTION_DAYS=90

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Email (for OTP fallback & notifications) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@authoryx.com

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Optional: OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Self-hosted flags ─────────────────────────────────────────────────────────
# Disable telemetry back to authoryx.com (set true for air-gapped installs)
DISABLE_TELEMETRY=false

# Allow open registration (false = invite-only)
ALLOW_OPEN_REGISTRATION=true
