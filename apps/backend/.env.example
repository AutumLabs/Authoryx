# AuthoryxOS backend configuration. Copy to .env and edit.
# All variables are prefixed AUTHORYX_.

# dev | prod | test. In prod, MASTER_KEY/SESSION_SECRET/OWNER_PASSWORD are required.
AUTHORYX_ENV=dev

# SQLite for local dev; Postgres for production.
# AUTHORYX_DATABASE_URL=postgresql+psycopg://authoryx:authoryx@postgres:5432/authoryx
AUTHORYX_DATABASE_URL=sqlite:///./authoryxos.db

# 32-byte hex key wrapping per-secret DEKs. REQUIRED in prod.
#   openssl rand -hex 32
AUTHORYX_MASTER_KEY=

# Dashboard owner login + signed-session secret. REQUIRED in prod.
AUTHORYX_OWNER_PASSWORD=
#   openssl rand -hex 32
AUTHORYX_SESSION_SECRET=

# Public base URL (used to build approve links in notifications).
AUTHORYX_PUBLIC_URL=http://localhost:8787

# Policy defaults.
AUTHORYX_DEFAULT_POLICY=require_approval
# Dev only: auto-approve every request (ignored in prod).
AUTHORYX_AUTO_APPROVE=false

# Protocol tunables (seconds).
AUTHORYX_CLOCK_SKEW_SECONDS=300
AUTHORYX_PENDING_TTL_SECONDS=3600
AUTHORYX_POLL_INTERVAL_SECONDS=5

# Notifications (all optional; leave blank to disable a channel).
AUTHORYX_NOTIFY_WEBHOOK_URL=
AUTHORYX_NOTIFY_WEBHOOK_SECRET=
AUTHORYX_NOTIFY_SLACK_WEBHOOK_URL=
AUTHORYX_SMTP_HOST=
AUTHORYX_SMTP_PORT=587
AUTHORYX_SMTP_USER=
AUTHORYX_SMTP_PASSWORD=
AUTHORYX_SMTP_FROM=authoryxos@localhost
AUTHORYX_NOTIFY_EMAIL_TO=

# Comma-separated CORS origins.
AUTHORYX_CORS_ORIGINS=*
