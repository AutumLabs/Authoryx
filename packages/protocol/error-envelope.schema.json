{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authoryxos.dev/schemas/v1/error-envelope.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_api_key", "invalid_intent", "replayed_nonce",
            "clock_skew", "unknown_key", "expired_token",
            "denied", "rate_limited", "internal"
          ]
        },
        "message":   { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
