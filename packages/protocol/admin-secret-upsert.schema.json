{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authoryxos.dev/schemas/v1/admin-secret-upsert.json",
  "title": "AdminSecretUpsert",
  "description": "Body of POST /v1/admin/keys — create or replace a stored secret. Requires an admin-scoped API key.",
  "type": "object",
  "required": ["key_name", "value"],
  "additionalProperties": false,
  "properties": {
    "key_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "value": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "description": { "type": "string", "maxLength": 512 },
    "default_policy": {
      "type": "string",
      "enum": ["approve_once", "always_approve", "require_approval"]
    },
    "source": {
      "type": "string",
      "description": "Optional provenance, e.g. 'scanner:src/db.py:42'.",
      "maxLength": 512
    }
  }
}
