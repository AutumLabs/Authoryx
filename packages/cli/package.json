{
  "name": "authoryx",
  "version": "0.1.0",
  "description": "The Authoryx command-line tool for agents: sign in, ask to use a secret, wait for the owner's answer, run a program with it.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "authoryx": "dist/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "hooks",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@authoryx/core": "0.1.0",
    "@authoryx/sdk": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutumLabs/Authoryx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/AutumLabs/Authoryx#readme",
  "keywords": [
    "authoryx",
    "agents",
    "secrets",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
