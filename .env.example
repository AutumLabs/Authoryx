# AuthoryxOS deployment configuration (docker-compose).
# `scripts/bootstrap.sh` generates a filled .env for you; or copy this file
# to .env and set the values yourself.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me

# ── Backend (prod) ────────────────────────────────────────────────────────────
# 32-byte hex. Wraps per-secret data keys. REQUIRED.   openssl rand -hex 32
AUTHORYX_MASTER_KEY=

# Dashboard owner login.                                REQUIRED.
AUTHORYX_OWNER_PASSWORD=

# Signed-session secret for the dashboard.              REQUIRED.   openssl rand -hex 32
AUTHORYX_SESSION_SECRET=

# Public URL of this deployment (used in approval notifications).
AUTHORYX_PUBLIC_URL=http://localhost:8787

# Default approval policy: require_approval | approve_once | always_approve
AUTHORYX_DEFAULT_POLICY=require_approval

# ── Optional notifications ───────────────────────────────────────────────────
AUTHORYX_NOTIFY_SLACK_WEBHOOK_URL=
AUTHORYX_NOTIFY_WEBHOOK_URL=
AUTHORYX_NOTIFY_WEBHOOK_SECRET=
AUTHORYX_SMTP_HOST=
AUTHORYX_SMTP_PORT=587
AUTHORYX_SMTP_USER=
AUTHORYX_SMTP_PASSWORD=
AUTHORYX_SMTP_FROM=authoryxos@localhost
AUTHORYX_NOTIFY_EMAIL_TO=
