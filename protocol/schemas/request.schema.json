{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AutumLabs/Authoryx/blob/main/protocol/schemas/request.schema.json",
  "title": "Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "circleId",
    "state",
    "reason",
    "hint",
    "createdAt",
    "expiresAt",
    "usableUntil",
    "closedAt",
    "outcome",
    "items",
    "awaiting",
    "approvalUrl"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "circleId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "closed"
      ]
    },
    "reason": {
      "type": "string"
    },
    "hint": {
      "enum": [
        "once",
        "1h",
        "always",
        null
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "usableUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyName",
          "state",
          "usableUntil"
        ],
        "properties": {
          "keyName": {
            "type": "string"
          },
          "state": {
            "enum": [
              "pending",
              "approved",
              "denied",
              "expired"
            ]
          },
          "usableUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "awaiting": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "keyNames"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "keyNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "approvalUrl": {
      "type": "string",
      "format": "uri"
    }
  }
}
