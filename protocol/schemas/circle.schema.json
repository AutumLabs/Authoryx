{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AutumLabs/Authoryx/blob/main/protocol/schemas/circle.schema.json",
  "title": "Circle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
